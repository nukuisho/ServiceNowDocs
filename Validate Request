(function execute(inputs, outputs) {
    outputs.valid = false;
    outputs.error_code = '';
    outputs.error_message = '';
    outputs.resolved_attachment_sys_id = '';

    /*
     * Excelファイルとして許可する最大件数。
     *
     */
    var MAX_EXCEL_ATTACHMENTS = 1;

    var EXPECTED_HEADERS = [
        'IP アドレス',
        'モデルパターンによる想定利用用途',
        'IPパターン : 備考',
        '実際の利用用途',
        '実際の利用用途 : 備考',
        'ステータス',
        'IPアドレス並び替え'
    ];

    function headerValue(value) {
        return value === null || value === undefined
            ? '' : String(value).trim();
    }

    function headerArray(source) {
        var result = [];
        var i;
        if (!source) return result;
        if (typeof source.length === 'number') {
            for (i = 0; i < source.length; i++) {
                result.push(headerValue(source[i]));
            }
        } else if (typeof source.size === 'function' &&
                   typeof source.get === 'function') {
            for (i = 0; i < source.size(); i++) {
                result.push(headerValue(source.get(i)));
            }
        } else if (typeof source.iterator === 'function') {
            var iterator = source.iterator();
            while (iterator.hasNext()) {
                result.push(headerValue(iterator.next()));
            }
        }
        return result;
    }

    function validateHeaders(rawHeaders) {
        var actual = headerArray(rawHeaders);
        var messages = [];
        var countInvalid = actual.length !== EXPECTED_HEADERS.length;
        if (countInvalid) {
            messages.push('Excelの列数が正しくありません。期待値: ' +
                EXPECTED_HEADERS.length + '、実際: ' + actual.length);
        }
        var length = Math.max(actual.length, EXPECTED_HEADERS.length);
        for (var i = 0; i < length; i++) {
            var expected = i < EXPECTED_HEADERS.length ? EXPECTED_HEADERS[i] : '';
            var found = i < actual.length ? actual[i] : '';
            if (found !== expected) {
                messages.push(String(i + 1) +
                    '列目のヘッダーが正しくありません。期待値:「' +
                    expected + '」、実際:「' + found + '」');
            }
        }
        if (messages.length) {
            fail(countInvalid ? 'INVALID_HEADER_COUNT' : 'INVALID_HEADER',
                messages.join('\n'));
            return false;
        }
        return true;
    }


    /*
     * エラー出力を設定する。
     */
    function fail(code, message) {
        outputs.valid = false;
        outputs.error_code = String(code || '');
        outputs.error_message = String(message || '');
        outputs.resolved_attachment_sys_id = '';
    }

    /*
     * Sys ID形式を確認する。
     */
    function isValidSysId(value) {
        return /^[0-9a-f]{32}$/i.test(
            String(value || '').trim()
        );
    }

       /*
     * Excuted UserのSysID・ユーザーレコードの有無
     * 事業会社情報のフィールドの有無、Excuted Userに事業会社情報が割り振られているか検証する。
     */
    function validateExecutedUser(rawUserSysId) {
        var userSysId = headerValue(rawUserSysId);
        if (!isValidSysId(userSysId)) {
            fail('EXECUTED_USER_SYS_ID_INVALID',
                'Executed User sys_id is invalid.');
            return false;
        }
        var userRecord = new GlideRecord('sys_user');
        if (!userRecord.get(userSysId)) {
            fail('EXECUTED_USER_NOT_FOUND',
                'Executed User was not found.');
            return false;
        }
        if (!userRecord.isValidField('u_opcompany_code')) {
            fail('USER_OPCOMPANY_FIELD_INVALID',
                'sys_user.u_opcompany_code is not a valid field.');
            return false;
        }
        if (!headerValue(userRecord.getValue('u_opcompany_code'))) {
            fail('USER_OPCOMPANY_MISSING',
                'Executed User does not have operating company information.');
            return false;
        }
        return true;
    }

    /*
     * .xlsx形式のファイルのみ許可する。
     */
    function isExcelFile(fileName) {
        return /\.xlsx$/i.test(
            String(fileName || '').trim()
        );
    }
    /*
     * 指定されたテーブルとレコードに紐づく
     * Excel添付を検索する。
     *
     * 対象外の添付はエラーとする。
     */
    function findExcelAttachments(
        tableName,
        tableSysId
    ) {
        var results = [];

        if (!tableName || !isValidSysId(tableSysId)) {
            return results;
        }

        var attachment =
            new GlideRecord('sys_attachment');

        attachment.addQuery(
            'table_name',
            tableName
        );

        attachment.addQuery(
            'table_sys_id',
            tableSysId
        );

        attachment.orderByDesc('sys_created_on');
        attachment.query();

        while (attachment.next()) {
            var fileName = String(
                attachment.getValue('file_name') || ''
            ).trim();

                  if (!isExcelFile(fileName)) {
                // nullは許可されていない拡張子の検出を表す。
                return null;
            }

            results.push({
                sys_id: attachment.getUniqueValue(),
                file_name: fileName,
                table_name: String(
                    attachment.getValue(
                        'table_name'
                    ) || ''
                ),
                table_sys_id: String(
                    attachment.getValue(
                        'table_sys_id'
                    ) || ''
                )
            });

        }

        return results;
    }

    /*
     * RITMまたはREQからExcel添付を解決する。
     *
     * 優先順位:
     * 1. sc_req_item
     * 2. sc_request
     *
     * RITMにExcelが存在する場合はREQ側を検索しない。
     * これにより、注文時の添付コピーによる重複判定を
     * 避ける。
     */
    function resolveExcelAttachment(ritm) {
        var ritmSysId =
            ritm.getUniqueValue();

        var ritmAttachments =
            findExcelAttachments(
                'sc_req_item',
                ritmSysId
            );

        if (ritmAttachments === null) {
            return {
                success: false,
                code: 'INVALID_ATTACHMENT_EXTENSION',
                message:
                    '.xlsx形式のファイルを添付してください'
            };
        }

        if (
            ritmAttachments.length >
            MAX_EXCEL_ATTACHMENTS
        ) {
            return {
                success: false,
                code:
                    'MULTIPLE_EXCEL_ATTACHMENTS',
                message:
                    'Only one Excel attachment ' +
                    'is allowed on the Requested Item.'
            };
        }

        if (ritmAttachments.length === 1) {
            return {
                success: true,
                attachment:
                    ritmAttachments[0]
            };
        }

        /*
         * RITM直下にExcelがない場合のみ、
         * 親REQの添付を確認する。
         */
        var requestSysId = String(
            ritm.getValue('request') || ''
        ).trim();

         // 1. 必須チェック
        if (!requestSysId) {
            return {
                success: false,
                code: 'REQUEST_SYS_ID_MISSING',
                message: 'Request Sys ID is required.'
            };
        }

        // 2. 形式チェック
        if (!isValidSysId(requestSysId)) {
            return {
                success: false,
                code: 'REQUEST_SYS_ID_INVALID',
                message: 'Request Sys ID is invalid.'
            };
        }

        var requestAttachments =
            findExcelAttachments(
                'sc_request',
                requestSysId
            );

        if (requestAttachments === null) {
            return {
                success: false,
                code: 'INVALID_ATTACHMENT_EXTENSION',
                message:
                    '.xlsx形式のファイルを添付してください'
            };
        }

        if (
            requestAttachments.length >
            MAX_EXCEL_ATTACHMENTS
        ) {
            return {
                success: false,
                code:
                    'MULTIPLE_EXCEL_ATTACHMENTS',
                message:
                    'Only one Excel attachment ' +
                    'is allowed on the Request.'
            };
        }

        if (requestAttachments.length === 1) {
            return {
                success: true,
                attachment:
                    requestAttachments[0]
            };
        }

        return {
            success: false,
            code: 'EXCEL_ATTACHMENT_MISSING',
            message:
                'An Excel attachment is required.'
        };
    }

    /*
     * 1. Requested Item Sys ID
     */
    var requestedItemSysId = String(
        inputs.requested_item_sys_id || ''
    ).trim();

    if (!requestedItemSysId) {
        fail(
            'REQUESTED_ITEM_MISSING',
            'Requested Item Sys ID is required.'
        );
        return;
    }

    if (!isValidSysId(requestedItemSysId)) {
        fail(
            'REQUESTED_ITEM_SYS_ID_INVALID',
            'Requested Item Sys ID is invalid.'
        );
        return;
    }

    /*
     * 2. Requested Item
     */
    var ritm = new GlideRecord('sc_req_item');

    if (!ritm.get(requestedItemSysId)) {
        fail(
            'REQUESTED_ITEM_NOT_FOUND',
            'Requested Item could not be found.'
        );
        return;
    }

    /*
     * 3. Input Method
     */
    var inputMethod = String(
        inputs.input_method || ''
    ).trim().toLowerCase();

    if (
        inputMethod !== 'manual' &&
        inputMethod !== 'excel'
    ) {
        fail(
            'INPUT_METHOD_INVALID',
            'Input method must be either ' +
            'manual or excel.'
        );
        return;
    }

    /*
     * ユーザー検証：manual / excel の両方に適用する。
     */
    if (!validateExecutedUser(inputs.executed_user)) {
        return;
    }

    /*
     * 4. Manual
     *
     * Manual方式ではExcel関連変数を確認しない。
     * 
     */
    if (inputMethod === 'manual') {
        outputs.valid = true;
        return;
    }

    /*
     * 5. Excel attachment
     *
     * excel_import_completed、
     * excel_attachment_sys_id、
     * excel_import_session_id、
     * excel_import_hashには依存しない。
     *
     * RITM、または親REQに紐づくExcel添付を
     * サーバー側で検索する。
     */
    var resolved =
        resolveExcelAttachment(ritm);

    if (!resolved.success) {
        fail(
            resolved.code,
            resolved.message
        );
        return;
    }

    var resolvedAttachment =
        resolved.attachment;

    if (
        !resolvedAttachment ||
        !isValidSysId(
            resolvedAttachment.sys_id
        )
    ) {
        fail(
            'EXCEL_ATTACHMENT_RESOLUTION_FAILED',
            'The Excel attachment could not be resolved.'
        );
        return;
    }

    /*
     * 6. Attachment readability and Excel parsing
     *
     * パーサーの既定シートを使用する。
     */
    var parser = null;

    try {
        var parseStream =
            new GlideSysAttachment()
                .getContentStream(
                    resolvedAttachment.sys_id
                );

        if (!parseStream) {
            fail(
                'ATTACHMENT_READ_FAILED',
                '添付ファイルを読み取れませんでした。'
            );
            return;
        }

        parser = new sn_impex.GlideExcelParser();
        parser.setSource(parseStream);

        if (!parser.parse()) {
            fail(
                'PARSE_FAILED',
                '添付ファイルをExcelとして解析できませんでした。'
            );
            return;
        }

        // パーサーをcloseする前にヘッダーを取得・検証する。
        var rawHeaders;
        try {
            rawHeaders = parser.getColumnHeaders();
        } catch (headerError) {
            fail(
                'HEADER_READ_FAILED',
                'Excelヘッダーを取得できませんでした。System error: ' +
                headerValue(headerError && headerError.message
                    ? headerError.message : headerError)
            );
            return;
        }
        if (!validateHeaders(rawHeaders)) {
            return;
        }
    } catch (parseError) {
        var parseErrorMessage = String(
            parseError && parseError.message
                ? parseError.message
                : parseError || 'Unknown parser error'
        ).trim();

        gs.error(
            '[Validate Request] ' +
            'Failed to read or parse attachment. ' +
            'RITM=' + requestedItemSysId +
            ', Attachment=' + resolvedAttachment.sys_id +
            ', Error=' + parseErrorMessage
        );

        fail(
            'PARSE_EXCEPTION',
            '添付ファイルの読み取り・Excel解析中に' +
            'エラーが発生しました。'
        );
        return;
    } finally {
        if (parser) {
            try {
                parser.close();
            } catch (closeError) {
                gs.error(
                    '[Validate Request] ' +
                    'Failed to close Excel parser. ' +
                    'RITM=' + requestedItemSysId +
                    ', Attachment=' + resolvedAttachment.sys_id +
                    ', Error=' + String(closeError)
                );
            }
        }
    }

    /*
     * 7. Final result
     *
     * Excelの行データ、IPアドレスなどの
     * 内容検証はValidate IP Address Excelで行う。
     */
    outputs.valid = true;
    outputs.resolved_attachment_sys_id =
        resolvedAttachment.sys_id;

})(inputs, outputs);
