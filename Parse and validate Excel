(function execute(inputs, outputs) {

    /*
     * ============================================================
     * 出力値の初期化
     * ============================================================
     */

    outputs.valid = false;
    outputs.rows = [];
    outputs.errors = [];
    outputs.row_count = 0;
    outputs.skipped_count = 0;
    outputs.attachment_sys_id = '';
    outputs.error_code = '';
    outputs.error_message = '';
    outputs.failed_count = 0;
    outputs.total_count = 0;
    outputs.segment_sys_id = '';

    /*
     * ============================================================
     * 変数の設定
     * ============================================================
    */

    // finallyで解放するパーサーの保持先。
    var parser = null;
    var IP_TABLE = 'u_ip_address';
    var IP_FIELD = 'ip_address';
   
   /*
     * 編集不可項目。
     */
    var IP_PATTERN_FIELD = 'u_ip_pattern';
    var USE_FIELD = 'u_use';
    var COMMENTS_FIELD = 'comments';
    var STATE_FIELD = 'u_state';
    var IP_PATTERN_COMMENTS_FIELD = 'comments';
    var SEGMENT_FIELD = 'u_segment';

    /*
     * u_ip_patternはReferenceフィールドを想定する。
     *
     * Excelにはユーザー向けの表示値が出力される想定のため、
     * 既存レコードのgetDisplayValue('u_ip_pattern')と比較する。
     *
     */
    var COMPARE_IP_PATTERN_BY_DISPLAY_VALUE = true;

    /*
     * 既知のu_state表示値を内部値へ変換する。
     * 状態値の妥当性は行処理内で差分判定後に検証する。
     */
    var STATE_VALUE_MAP = {
        '未使用': '1',
        '使用中': '2'
    };

    /*
     * ============================================================
     * 内部変数の初期化
     * ============================================================
     */

    var errors = [];
    var rows = [];
    var seenIp = {};
    var rowCount = 0;
    var skippedCount = 0;
    var failedCount = 0;
    var commonSegmentSysId = '';
    var ipLookup = {};


    /*
     * ============================================================
     * ユーティリティ関数
     * ============================================================
     */

    function closeExcelParser(instance, label) {
        if (!instance) return;
        try {
            instance.close();
        } catch (closeError) {
            gs.error(
                '[Parse and validate Excel] Failed to close ' + label +
                '. RITM=' + String(inputs.request_item_sys_id || '') +
                ', Attachment=' + String(inputs.attachment_sys_id || '') +
                ', Error=' + String(closeError)
            );
        }
    }

    /*
     * nullおよびundefinedを空文字へ変換し、
     * 前後の空白を除去する。
     */
    function valueOf(value) {
        if (
            value === null ||
            value === undefined
        ) {
            return '';
        }

        return String(value).trim();
    }

    /*
     * 改行コードをLFへ統一する。
     * ExcelとServiceNowでCRLF/LFが異なることによる誤検出を防止する。
     */
    function multilineValueOf(value) {
        return valueOf(value)
            .replace(/\r\n/g, '\n')
            .replace(/\r/g, '\n');
    }

    function isValidSysId(value) {
        return /^[0-9a-f]{32}$/i.test(
            valueOf(value)
        );
    }

    function hasOwn(object, property) {
        return Object.prototype.hasOwnProperty.call(
            object,
            property
        );
    }

    /*
     * エラーを構造化する。
     */
    function addError(
        rowNumber,
        column,
        code,
        message
    ) {
        errors.push({
            row_number:
                parseInt(rowNumber, 10) || 0,

            column:
                valueOf(column),

            code:
                valueOf(code),

            message:
                valueOf(message)
        });
    }

/*
 * errors配列を、Flowへ渡す単一のエラーメッセージへ変換する。
 */
function buildErrorMessage() {
    var messages = [];

    for (
        var errorIndex = 0;
        errorIndex < errors.length;
        errorIndex++
    ) {
        var error = errors[errorIndex];
        var parts = [];

        if (
            error.row_number &&
            parseInt(
                error.row_number,
                10
            ) > 0
        ) {
            parts.push(
                String(error.row_number) +
                '行目'
            );
        }
 
        var prefix = '';

        if (parts.length > 0) {
            prefix =
                '[' +
                parts.join(' / ') +
                '] ';
        }

        messages.push(
            prefix +
            valueOf(error.message)
        );
    }

    return messages.join('\n');
}

/*
 * Flowへ渡す代表エラーコードを決定する。
 *
 * エラーが1件だけの場合:
 *   そのエラー固有のコードを返す。
 *
 * エラーが複数ある場合:
 *   EXCEL_VALIDATION_FAILEDを返す。
 */
function buildErrorCode() {
    if (errors.length === 0) {
        return '';
    }

    if (errors.length === 1) {
        return valueOf(
            errors[0].code
        );
    }

    return 'EXCEL_VALIDATION_FAILED';
}

    /*
     * 失敗結果を出力する。
     *
     * 1行でもエラーがある場合は、部分更新を防止するためrowsを必ず空配列にする。
     */
function publishFailure() {
    outputs.total_count = rowCount;
    outputs.valid = false;
    outputs.rows = [];
    outputs.errors = errors;
    outputs.row_count = rowCount;
    outputs.skipped_count = skippedCount;
    outputs.failed_count = failedCount;
    outputs.segment_sys_id = '';

    outputs.error_code =
        buildErrorCode();

    outputs.error_message =
        buildErrorMessage();
}

    function publishSuccess() {
        outputs.total_count = rowCount;
        outputs.valid = true;
        outputs.rows = rows;
        outputs.errors = [];
        outputs.row_count = rowCount;
        outputs.skipped_count = skippedCount;
        outputs.failed_count = failedCount;
        outputs.segment_sys_id = commonSegmentSysId;

    }

    /*
     * 完全一致する日本語ヘッダーのセルを取得する。
     */
    function getCell(source, headerName) {
        if (!source || !hasOwn(source, headerName)) {
            return '';
        }

        return valueOf(source[headerName]);
    }

    /*
     * 取得したIPアドレスレコードについて、
     * 今回使用するフィールドが存在することを検証する。
     */
    function validateIpRecordFields(record) {
        var requiredFields = [
            IP_FIELD,
            IP_PATTERN_FIELD,
            USE_FIELD,
            COMMENTS_FIELD,
            STATE_FIELD,
        ];

        var valid = true;

        for (
            var fieldIndex = 0;
            fieldIndex < requiredFields.length;
            fieldIndex++
        ) {
            var fieldName =
                requiredFields[fieldIndex];

            if (!record.isValidField(fieldName)) {
                addError(
                    0,
                    fieldName,
                    'INVALID_SERVER_FIELD',
                    'テーブル側に該当するフィールドが存在しません。' +
                    IP_TABLE +
                    '.' +
                    fieldName
                );
                failedCount++;
                valid = false;
            }
        }

        return valid;
    }

    /*
     * u_ip_patternの比較値を取得する。
     *
     * Excelに表示値が出力される場合は表示値を取得する。
     * 
     */
    function getCurrentIpPatternValue(
        ipRecord
    ) {
        if (hasOwn(ipRecord, 'snapshotPattern')) return ipRecord.snapshotPattern;

        if (
            COMPARE_IP_PATTERN_BY_DISPLAY_VALUE
        ) {
            return valueOf(
                ipRecord.getDisplayValue(
                    IP_PATTERN_FIELD
                )
            );
        }

        return valueOf(
            ipRecord.getValue(
                IP_PATTERN_FIELD
            )
        );
    }

    /*
     * u_ip_pattern参照先レコードのcommentsを取得する。
     *（u_ip_pattern.commentsのドットウォークに相当）
     */
    function getCurrentIpPatternComments(
        ipRecord
    ) {
        if (hasOwn(ipRecord, 'snapshotPatternComments')) return ipRecord.snapshotPatternComments;

        var patternSysId =
            valueOf(
                ipRecord.getValue(
                    IP_PATTERN_FIELD
                )
            );

        if (!patternSysId) {
            return '';
        }

        var patternRecord;

        try {
            patternRecord =
                ipRecord[
                    IP_PATTERN_FIELD
                ].getRefRecord();
        } catch (referenceError) {
            return '';
        }

        if (
            !patternRecord ||
            !patternRecord.isValidRecord()
        ) {
            return '';
        }

        if (
            !patternRecord.isValidField(
                IP_PATTERN_COMMENTS_FIELD
            )
        ) {
            return '';
        }

        return multilineValueOf(
            patternRecord.getValue(
                IP_PATTERN_COMMENTS_FIELD
            )
        );
    }

    /*
     * 編集不可の項目を既存レコードと比較する。
     *
     * 比較対象:
     * - u_ip_address
     * - u_ip_pattern
     * - u_ip_pattern.comments
     * Excelの「Sys ID」は、この関数ではなく一括取得前に参照先セグメントの存在を確認する。
     */
    function validateServerControlledFields(
        row,
        ipRecord
    ) {
        var valid = true;

        var currentIpAddress =
            valueOf(
                ipRecord.getValue(
                    IP_FIELD
                )
            );

        var currentIpPattern =
            getCurrentIpPatternValue(
                ipRecord
            );

        var currentIpPatternComments =
            getCurrentIpPatternComments(
                ipRecord
            );

        if (
            row.u_ip_address !==
            currentIpAddress
        ) {
            addError(
                row.row_number,
                'u_ip_address',
                'SERVER_VALUE_MISMATCH',
                '「IP アドレス」が既存レコードと' +
                '一致しません。' +
                'Excel値:「' +
                row.u_ip_address +
                '」、既存値:「' +
                currentIpAddress +
                '」'
            );
            failedCount++;

            valid = false;
        }

        if (
            row.u_ip_pattern !==
            currentIpPattern
        ) {
            addError(
                row.row_number,
                'u_ip_pattern',
                'SERVER_VALUE_MISMATCH',
                '「モデルパターンによる想定利用用途」が' +
                '既存レコードと一致しません。' +
                'Excel値:「' +
                row.u_ip_pattern +
                '」、既存値:「' +
                currentIpPattern +
                '」'
            );
            failedCount++;

            valid = false;
        }

        if (
            row.u_ip_pattern_comments !==
            currentIpPatternComments
        ) {
            addError(
                row.row_number,
                'u_ip_pattern_comments',
                'SERVER_VALUE_MISMATCH',
                '「IPパターン : 備考」が' +
                '既存レコードと一致しません。' +
                'Excel値:「' +
                row.u_ip_pattern_comments +
                '」、既存値:「' +
                currentIpPatternComments +
                '」'
            );
            failedCount++;

            valid = false;
        }

        return valid;
    }

    function containsSysId(rawValues, expectedSysId) {
        var expected = valueOf(expectedSysId);
        var valuesText = valueOf(rawValues);

        if (!expected || !valuesText) {
            return false;
        }

        var values = valuesText.split(',');

        for (var valueIndex = 0;
            valueIndex < values.length;
            valueIndex++) {

            if (valueOf(values[valueIndex]) === expected) {
                return true;
            }
        }

        return false;
    }



    function getIpOpCompany(target, rowNumber) {
        if (hasOwn(target, 'snapshotCompany')) {
            return {
                valid: target.snapshotCompany.valid,
                value: target.snapshotCompany.value,
                message: target.snapshotCompany.message.replace(
                    /Excel row 0\./g, 'Excel row ' + rowNumber + '.')
            };
        }

        var result = {
            valid: false,
            value: '',
            message: ''
        };

        if (!target.isValidField(SEGMENT_FIELD)) {
            result.message =
                SEGMENT_FIELD + ' is not a valid field at Excel row ' +
                rowNumber + '.';
            return result;
        }

        var segmentRecord = target[SEGMENT_FIELD].getRefRecord();

        if (!segmentRecord || !segmentRecord.isValidRecord()) {
            result.message =
                'Segment record was not found at Excel row ' +
                rowNumber + '.';
            return result;
        }

        if (!segmentRecord.isValidField('u_store_code')) {
            result.message =
                'u_store_code is not a valid field at Excel row ' +
                rowNumber + '.';
            return result;
        }

        var storeRecord =
            segmentRecord.u_store_code.getRefRecord();

        if (!storeRecord || !storeRecord.isValidRecord()) {
            result.message =
                'Store record was not found at Excel row ' +
                rowNumber + '.';
            return result;
        }

        if (!storeRecord.isValidField('u_company_code')) {
            result.message =
                'u_company_code is not a valid field at Excel row ' +
                rowNumber + '.';
            return result;
        }

        var companyRecord =
            storeRecord.u_company_code.getRefRecord();

        if (!companyRecord || !companyRecord.isValidRecord()) {
            result.message =
                'Company record was not found at Excel row ' +
                rowNumber + '.';
            return result;
        }

        if (!companyRecord.isValidField('u_opcompany_code')) {
            result.message =
                'u_opcompany_code is not a valid field at Excel row ' +
                rowNumber + '.';
            return result;
        }

        var opCompanyRecord =
            companyRecord.u_opcompany_code.getRefRecord();

        if (!opCompanyRecord || !opCompanyRecord.isValidRecord()) {
            result.message =
                'Operating company record was not found at Excel row ' +
                rowNumber + '.';
            return result;
        }

        result.value = valueOf(
            opCompanyRecord.getUniqueValue()
        );

        if (!result.value) {
            result.message =
                'Operating company sys_id is empty at Excel row ' +
                rowNumber + '.';
            return result;
        }

        result.valid = true;
        return result;
    }

    // DBから取得した値をコピーし、IPごとのGlideRecordは保持しない。
    function snapshotIp(record) {
        var fields = [IP_FIELD, IP_PATTERN_FIELD, USE_FIELD, COMMENTS_FIELD,
            STATE_FIELD, SEGMENT_FIELD];
        var values = {};
        var available = {};
        for (var i = 0; i < fields.length; i++) {
            available[fields[i]] = record.isValidField(fields[i]);
            values[fields[i]] = available[fields[i]]
                ? valueOf(record.getValue(fields[i])) : '';
        }
        var id = valueOf(record.getUniqueValue());
        var pattern = getCurrentIpPatternValue(record);
        var patternComments = getCurrentIpPatternComments(record);
        var company = getIpOpCompany(record, 0);
        return {
            getUniqueValue: function () { return id; },
            getValue: function (field) { return values[field]; },
            isValidField: function (field) { return !!available[field]; },
            snapshotPattern: pattern,
            snapshotPatternComments: patternComments,
            snapshotCompany: company
        };
    }

    function loadSegmentRecords(segmentId) {
        var target = new GlideRecordSecure(IP_TABLE);
        if (!target.isValid() || !target.isValidField(IP_FIELD) ||
            !target.isValidField(SEGMENT_FIELD)) {
            addError(0, '', 'SERVER_CONFIGURATION_ERROR',
                'IPアドレステーブルまたは検索用フィールドが存在しません。');
            return false;
        }
        // 所属セグメントフィールドの参照先テーブルを取得する。
        var segmentTable = valueOf(
            target.getElement(SEGMENT_FIELD).getReferenceTable()
        );
        if (!segmentTable) {
            addError(0, SEGMENT_FIELD, 'SERVER_CONFIGURATION_ERROR',
                '所属セグメントの参照先テーブルが設定されていません。');
            return false;
        }

        // ExcelのSys IDに対応するセグメントレコードが存在するか確認する。
        var segmentRecord = new GlideRecordSecure(segmentTable);
        if (!segmentRecord.isValid()) {
            addError(0, SEGMENT_FIELD, 'SERVER_CONFIGURATION_ERROR',
                '所属セグメントの参照先テーブルが有効ではありません。');
            return false;
        }
        if (!segmentRecord.get(segmentId)) {
            addError(0, 'segment_sys_id', 'SERVER_VALUE_MISMATCH_SYS_ID',
                '「Sys ID」が更新されています。' +
                'エクスポートした値から変更しないでください。' +
                '最新のExcelを再度エクスポートし、送信しなおしてください。');
            return false;
        }

        // この検証アクションでIPテーブルを検索するのは、この1回だけ。
        target.addQuery(SEGMENT_FIELD, segmentId);
        target.query();
        while (target.next()) {
            var key = '_' + valueOf(target.getValue(IP_FIELD));
            if (!hasOwn(ipLookup, key)) ipLookup[key] = [];
            ipLookup[key].push(snapshotIp(target));
        }
        return true;
    }

    function findTargetRecord(row, rowNumber, segmentSysId) {
        var result = { valid: false, record: null, message: '' };
        var key = '_' + valueOf(row.u_ip_address);
        var matches = hasOwn(ipLookup, key) ? ipLookup[key] : [];
        if (!matches.length) {
            result.message = '指定セグメント内に対象のIPアドレスが見つかりません。' +
                ' Excel row: ' + rowNumber + '.';
            return result;
        }
        if (matches.length !== 1) {
            result.message = '指定セグメント内で対象のIPアドレスに複数のレコードが一致しました。' +
                ' Excel row: ' + rowNumber + '.';
            return result;
        }
        var record = matches[0];
        if (valueOf(record.getValue(SEGMENT_FIELD)).toLowerCase() !== segmentSysId) {
            result.message = '対象レコードのセグメントが一致しません。';
            return result;
        }
        result.valid = true;
        result.record = record;
        return result;
    }

    function normalizeState(rawState) {
        var state = valueOf(rawState);

        if (
            state === '未使用' ||
            state === 'Unused' ||
            state === '1'
        ) {
            return '1';
        }

        if (
            state === '使用中' ||
            state === 'Used' ||
            state === '2'
        ) {
            return '2';
        }

        return state;
    }

    function getExcelUpdateFlags(row, target) {
        var inputComments = multilineValueOf(row.comments);
        var currentComments = multilineValueOf(
            target.getValue('comments')
        );

        var inputUse = valueOf(row.u_use);
        var currentUse = valueOf(
            target.getValue('u_use')
        );

        var inputState = normalizeState(row.u_state);
        var currentState = normalizeState(
            target.getValue('u_state')
        );

        return {
            update_comments: inputComments !== currentComments,
            update_u_use: inputUse !== currentUse,
            update_u_state: inputState !== currentState
        };
    }

    try {

    /*
     * 添付ファイルを、パーサーの既定の先頭シートで解析する。
     */
    var attachmentSysId = valueOf(inputs.attachment_sys_id);
    var executedUser = valueOf(inputs.executed_user);
    var userOpCompany = valueOf(inputs.executed_user_opcompany);
    outputs.attachment_sys_id = attachmentSysId;

    try {
        var parseStream = new GlideSysAttachment()
            .getContentStream(attachmentSysId);
        if (!parseStream) {
            addError(0, '', 'ATTACHMENT_READ_FAILED',
                '添付ファイルを読み取れませんでした。');
            publishFailure();
            return;
        }
        parser = new sn_impex.GlideExcelParser();
        parser.setSource(parseStream);
        if (!parser.parse()) {
            addError(0, '', 'PARSE_FAILED',
                '添付ファイルをExcelとして解析できませんでした。');
            publishFailure();
            return;
        }
    } catch (parseError) {
        gs.error('[Parse and validate Excel] Attachment=' + attachmentSysId +
            ', Error=' + valueOf(parseError && parseError.message
                ? parseError.message : parseError));
        addError(0, '', 'PARSE_EXCEPTION',
            '添付ファイルの読み取り・Excel解析中にエラーが発生しました。');
        publishFailure();
        return;
    }

    /* ヘッダーは前段で検証済みとし、ここでSys IDの事前確認と行データの検証を行う。 */
    var excelRow = 1;
    var bufferedRows = [];
    var scanHeaders = ['IP アドレス', 'モデルパターンによる想定利用用途',
        'IPパターン : 備考', '実際の利用用途', '実際の利用用途 : 備考',
        'ステータス', 'Sys ID'];
    while (parser.next()) {
        excelRow++;
        var scanRow = parser.getRow() || {};
        var hasData = false;
        var copy = {};
        for (var scanIndex = 0; scanIndex < scanHeaders.length; scanIndex++) {
            var header = scanHeaders[scanIndex];
            copy[header] = getCell(scanRow, header);
            if (copy[header]) hasData = true;
        }
        if (!hasData) continue;
        bufferedRows.push({ number: excelRow, source: copy });
        var scanId = copy['Sys ID'].toLowerCase();
        // Sys IDの必須確認
        if (!scanId) {
            addError(
                excelRow,
                'segment_sys_id',
                'EMPTY_SYS_ID',
                '「Sys ID」が更新されています。' +
                'エクスポートした値から変更しないでください。' +
                '最新のExcelを再度エクスポートし、送信しなおしてください。'
            );
            failedCount++;
            continue;
        }

        // Excel内で異なるSys IDが混在していないか確認
        if (commonSegmentSysId && scanId !== commonSegmentSysId) {
            addError(
                excelRow,
                'segment_sys_id',
                'DUPLICATE_SYS_ID',
                '「Sys ID」が更新されています。' +
                'エクスポートした値から変更しないでください。' +
                '最新のExcelを再度エクスポートし、送信しなおしてください。'
            );
            failedCount++;
            continue;
        }

        if (!commonSegmentSysId) commonSegmentSysId = scanId;

        // Sys IDの形式確認
        if (!isValidSysId(scanId)) {
            addError(
                excelRow,
                'segment_sys_id',
                'SERVER_VALUE_MISMATCH_SYS_ID',
                '「Sys ID」が更新されています。' +
                'エクスポートした値から変更しないでください。' +
                '最新のExcelを再度エクスポートし、送信しなおしてください。'
            );
            failedCount++;
            continue;
        }


    }
    if (errors.length) {
        rowCount = bufferedRows.length;
        publishFailure();
        return;
    }
    if (bufferedRows.length && !loadSegmentRecords(commonSegmentSysId)) {
        rowCount = bufferedRows.length;
        publishFailure();
        return;
    }

    var bufferedIndex = 0;
    // 以降のIP照合は、メモリ上に保存した対象セグメントのデータを使用する。
    while (bufferedIndex < bufferedRows.length) {
        var bufferedRow = bufferedRows[bufferedIndex++];
        excelRow = bufferedRow.number;
        var source = bufferedRow.source;

        /*
         * 日本語ヘッダーから値を取得し、
         * 英数字の内部名へマッピングする。
         */
        var ipAddress =
            getCell(
                source,
                'IP アドレス'
            );

        var ipPattern =
            getCell(
                source,
                'モデルパターンによる想定利用用途'
            );

        var ipPatternComments =
            multilineValueOf(
                getCell(
                    source,
                    'IPパターン : 備考'
                )
            );

        var useName =
            getCell(
                source,
                '実際の利用用途'
            );

        var actualUseComments =
            multilineValueOf(
                getCell(
                    source,
                    '実際の利用用途 : 備考'
                )
            );

        var stateName =
            getCell(
                source,
                'ステータス'
            );

        var segmentSysId = 
            getCell(
                source,
                 'Sys ID'
            );


        /*
         * 全項目が空の行はデータ行として数えず、
         * 読み飛ばす。
         */
        if (
            !ipAddress &&
            !ipPattern &&
            !ipPatternComments &&
            !useName &&
            !actualUseComments &&
            !stateName &&
            !segmentSysId
        ) {
            continue;
        }

        rowCount++;

        var errorCountBefore =
            errors.length;

        var targetSysId = '';
        var targetResult = null;

        /*
         * 更新用の内部値。
         */
        var useValue = useName;
        var stateValue = stateName;

        /*
         * IPアドレスは更新対象レコードを特定するため必須。
         */
        if (!ipAddress) {
            addError(
                excelRow,
                'u_ip_address',
                'EMPTY_KEY',
                '「IP アドレス」は必須です。'
            );
            failedCount++;
        } else {
            var duplicateKey =
                '_' + ipAddress;

            if (seenIp[duplicateKey]) {
                addError(
                    excelRow,
                    'u_ip_address',
                    'DUPLICATE_KEY',
                    'IP アドレス「' +
                    ipAddress +
                    '」がExcel内で重複しています。'
                );
                failedCount++;
            } else {
                seenIp[duplicateKey] = true;

              var targetResult = findTargetRecord(
                    { u_ip_address: ipAddress },
                    excelRow,
                    commonSegmentSysId
            );
            
                if (!targetResult.valid) {
                    addError(excelRow, 'u_ip_address',
                        'TARGET_RECORD_INVALID', targetResult.message);
                    failedCount++;
                } else {
                    targetSysId = valueOf(
                        targetResult.record.getUniqueValue()
                    );
                }
            }
        }

        /*
         * 既知のu_state表示値だけ内部値へ変換する。
         */
        if (
            stateName &&
            hasOwn(
                STATE_VALUE_MAP,
                stateName
            )
        ) {
            stateValue =
                STATE_VALUE_MAP[stateName];
        }

        /*
         * IP検索までにエラーがなければ、
         * 対象レコードを取得して編集不可項目を比較する。
         */
        var ipRecord = null;

        if (
            errors.length ===
                errorCountBefore &&
            targetSysId
        ) {
            // 行ループ前にGlideRecordSecureで取得・コピーした値を使用する。
            ipRecord = targetResult.record;

            if (valueOf(ipRecord.getValue(IP_FIELD)) !== ipAddress) {
                addError(
                    excelRow,
                    'u_ip_address',
                    'TARGET_IP_MISMATCH',
                    '対象レコードとIPアドレスが一致しません。'
                );
                failedCount++;
            } else if (
                !validateIpRecordFields(
                    ipRecord
                )
            ) {
                /*
                 * validateIpRecordFields内で
                 * 詳細エラーを追加済み。
                 */
            } else {
                var normalizedRow = {
                    row_number:
                        excelRow,

                    target_sys_id:
                        targetSysId,

                    /*
                     * 編集不可項目。
                     */
                    u_ip_address:
                        ipAddress,

                    u_ip_pattern:
                        ipPattern,

                    u_ip_pattern_comments:
                        ipPatternComments,

                    /*
                     * 更新対象項目。
                     */
                    u_use:
                        useValue,

                    comments:
                        actualUseComments,

                    u_state:
                        stateValue,

                    /*
                     * 更新フラグ。
                     */
                    update_u_use:
                        false,

                    update_comments:
                        false,

                    update_u_state:
                        false,

                    skip:
                        false
                };

                /*
                 * 編集不可項目に1つでも差分がある場合は、
                 * このAction全体をValid=falseとする。
                 */
                validateServerControlledFields(
                    normalizedRow,
                    ipRecord
                );

                if (errors.length === errorCountBefore) {
                    var ipOpCompanyResult = getIpOpCompany(ipRecord, excelRow);
                    if (!ipOpCompanyResult.valid) {
                        addError(excelRow, '', 'TARGET_OPCOMPANY_INVALID',
                            ipOpCompanyResult.message);
                        failedCount++;
                        continue;
                    }
                    if (!containsSysId(userOpCompany, ipOpCompanyResult.value)) {
                        addError(excelRow, '', 'OPCOMPANY_MISMATCH',
                            excelRow + '行目は更新できないレコードです。');
                        failedCount++;
                        continue;
                    }
                    normalizedRow.executed_by = executedUser;
                    normalizedRow.comments = multilineValueOf(normalizedRow.comments);
                    normalizedRow.u_use = valueOf(normalizedRow.u_use);
                    normalizedRow.u_state = normalizeState(normalizedRow.u_state);

                    var flags = getExcelUpdateFlags(normalizedRow, ipRecord);
                    if (flags.update_u_state &&
                        normalizedRow.u_state !== '' &&
                        normalizedRow.u_state !== '1' &&
                        normalizedRow.u_state !== '2') {
                        addError(excelRow, 'u_state', 'INVALID_STATE',
                            excelRow + '行目のStateが不正です。' +
                            '使用中、未使用、またはブランクを指定してください。');
                        failedCount++;
                        continue;
                    }
                    normalizedRow.update_comments = flags.update_comments;
                    normalizedRow.update_u_use = flags.update_u_use;
                    normalizedRow.update_u_state = flags.update_u_state;
                    normalizedRow.skip = !flags.update_comments &&
                        !flags.update_u_use && !flags.update_u_state;
                    if (normalizedRow.skip) skippedCount++;
                    rows.push(normalizedRow);
                }
            }
        }
    }

    /*
     * ============================================================
     * 最終結果
     * ============================================================
     */

    outputs.row_count =
        rowCount;

    outputs.skipped_count =
        skippedCount;

    outputs.errors =
        errors;

    /*
     * 1件でもエラーがある場合、部分更新を防止するため
     * rowsを空にしてValid=falseを返す。
     */
    if (errors.length > 0) {
        publishFailure();
        return;
    }

    publishSuccess();

    } catch (rowError) {
        // 行読み取りやDB参照などで発生した、未処理の例外を捕捉する。
        gs.error('[Parse and validate Excel] Row processing failed. Attachment=' +
            String(inputs.attachment_sys_id || '') + ', Error=' + String(rowError));
        addError(typeof excelRow === 'number' ? excelRow : 0,
            '', 'ROW_PROCESSING_EXCEPTION',
            'Excelの行読み取り・検証中にエラーが発生しました。');
        publishFailure();
        return;
    } finally {
        closeExcelParser(parser, 'row parser');
    }

})(inputs, outputs);
